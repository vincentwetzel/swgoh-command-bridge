<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:swgoh_command_bridge.UI.ViewModels"
             x:Class="swgoh_command_bridge.UI.Views.ModOptimizerView"
             x:DataType="vm:ModOptimizerViewModel">
  <Grid RowDefinitions="Auto, *" Margin="20">
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
      <TextBlock Text="{Binding HeaderText}" FontSize="26" FontWeight="Bold"/>
      <Button Content="Plan priority roster" Command="{Binding CalculateRosterCommand}" VerticalAlignment="Center"/>
      <Button Content="Optimize roster" Command="{Binding OptimizeRosterCommand}" VerticalAlignment="Center"/>
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="260, *" ColumnSpacing="16">
      <Border BorderBrush="#555555" BorderThickness="1" CornerRadius="6">
        <ListBox ItemsSource="{Binding Characters}" SelectedItem="{Binding SelectedCharacter}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Padding="8" Spacing="3">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Priority, StringFormat='Priority: {0}'}" Foreground="Gray"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <Border Grid.Column="1" BorderBrush="#555555" BorderThickness="1" CornerRadius="6" Padding="16">
        <Grid RowDefinitions="Auto, Auto, *">
          <TextBlock Text="Loading optimizer..." IsVisible="{Binding IsLoading}" HorizontalAlignment="Center"/>
          <TextBlock Grid.Row="1" Text="Select a character after syncing an account." IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" TextWrapping="Wrap"/>
          <StackPanel Grid.Row="2" IsVisible="{Binding HasError}" HorizontalAlignment="Center" Spacing="8" MaxWidth="360">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF8A80" TextWrapping="Wrap"/>
            <Button Content="Retry" Command="{Binding RefreshCommand}" HorizontalAlignment="Center"/>
          </StackPanel>
          <StackPanel Grid.Row="2" IsVisible="{Binding HasLoadout}" Spacing="12">
            <TextBlock Text="Recommended loadout" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding RecommendationStatusText}" TextWrapping="Wrap" Foreground="Gray"/>
            <TextBlock Text="{Binding PopularityText}" Foreground="Gray"/>
            <TextBlock Text="{Binding LastUpdatedText}" Foreground="Gray"/>
            <TextBlock Text="{Binding RecommendationSourceUrlText}" TextWrapping="Wrap" Foreground="Gray"/>
            <TextBlock Text="{Binding LoadoutStatusText}" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Refresh community data" Command="{Binding ScrapeCommand}"/>
              <Button Content="Refresh all" Command="{Binding ScrapeAllCommand}"/>
              <Button Content="Cancel" Command="{Binding CancelScrapeCommand}" IsVisible="{Binding IsScraping}"/>
            </StackPanel>
            <TextBlock Text="{Binding ScrapeStatusText}" TextWrapping="Wrap" Foreground="Gray"/>
            <TextBlock Text="{Binding LastScrapeSummaryText}" TextWrapping="Wrap" Foreground="Gray"/>
            <ListBox ItemsSource="{Binding RecommendedLoadout}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="100, *, Auto" Padding="6" ColumnSpacing="12">
                    <TextBlock Text="{Binding Slot, StringFormat='Slot {0}'}"/>
                    <TextBlock Grid.Column="1" Text="{Binding PrimaryStatType}"/>
                    <TextBlock Grid.Column="2" Text="{Binding Id}"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <ItemsControl ItemsSource="{Binding LoadoutExplanations}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="Gray" Margin="6,0,0,0"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding LoadoutScoreText}" TextWrapping="Wrap" Foreground="Gray"/>
            <TextBlock Text="Projected mod-stat impact" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding ProjectedStatSummaryText}" TextWrapping="Wrap" Foreground="Gray"/>
            <ItemsControl ItemsSource="{Binding ProjectedStatImpactSummaries}"
                          IsVisible="{Binding HasProjectedStatImpacts}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="Gray" Margin="6,0,0,0"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Alternatives" FontSize="16" FontWeight="SemiBold" IsVisible="{Binding HasAlternatives}"/>
            <ItemsControl ItemsSource="{Binding AlternativeSummaries}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="Gray" Margin="6,0,0,0"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Swap candidates" FontSize="16" FontWeight="SemiBold" IsVisible="{Binding HasSwapRecommendations}"/>
            <ItemsControl ItemsSource="{Binding SwapRecommendationSummaries}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#FFCC80" Margin="6,0,0,0"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Separator Margin="0,8"/>
            <TextBlock Text="Priority roster plan" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding RosterPlanStatusText}" TextWrapping="Wrap" Foreground="Gray"/>
            <ItemsControl ItemsSource="{Binding RosterPlanSummaries}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="Gray" Margin="6,0,0,0"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Roster swap candidates" FontSize="16" FontWeight="SemiBold"
                       IsVisible="{Binding HasRosterSwapRecommendations}"/>
            <ItemsControl ItemsSource="{Binding RosterSwapSummaries}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#FFCC80" Margin="6,0,0,0"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <StackPanel Grid.Row="2" IsVisible="{Binding IsEmpty}" Spacing="12">
            <TextBlock Text="No loadout is available for the selected character." FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding RecommendationStatusText}" TextWrapping="Wrap" Foreground="Gray"/>
            <TextBlock Text="{Binding LastUpdatedText}" Foreground="Gray"/>
            <TextBlock Text="{Binding RecommendationSourceUrlText}" TextWrapping="Wrap" Foreground="Gray"/>
            <TextBlock Text="{Binding LoadoutStatusText}" TextWrapping="Wrap"/>
            <Button Content="Refresh community data" Command="{Binding ScrapeCommand}"/>
            <Button Content="Refresh all" Command="{Binding ScrapeAllCommand}"/>
            <Button Content="Cancel" Command="{Binding CancelScrapeCommand}" IsVisible="{Binding IsScraping}"/>
            <TextBlock Text="{Binding ScrapeStatusText}" TextWrapping="Wrap" Foreground="Gray"/>
            <TextBlock Text="{Binding LastScrapeSummaryText}" TextWrapping="Wrap" Foreground="Gray"/>
            <Separator Margin="0,8"/>
            <TextBlock Text="Priority roster plan" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding RosterPlanStatusText}" TextWrapping="Wrap" Foreground="Gray"/>
            <ItemsControl ItemsSource="{Binding RosterPlanSummaries}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="Gray" Margin="6,0,0,0"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Roster swap candidates" FontSize="16" FontWeight="SemiBold"
                       IsVisible="{Binding HasRosterSwapRecommendations}"/>
            <ItemsControl ItemsSource="{Binding RosterSwapSummaries}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#FFCC80" Margin="6,0,0,0"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
