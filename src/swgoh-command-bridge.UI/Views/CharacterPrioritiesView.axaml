<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:swgoh_command_bridge.UI.ViewModels"
             x:Class="swgoh_command_bridge.UI.Views.CharacterPrioritiesView"
             x:DataType="vm:CharacterPrioritiesViewModel">
  <Grid x:Name="BoardRoot" RowDefinitions="Auto, Auto, *" Margin="24" DragDrop.AllowDrop="True">
    <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,10">
      <StackPanel Spacing="3">
        <TextBlock Text="{Binding HeaderText}" FontSize="26" FontWeight="Bold"/>
        <TextBlock Text="Drag portraits to a tier. Within a tier, leftmost units receive the highest priority. Changes save automatically."
                   Foreground="#AEB9C6" TextWrapping="Wrap"/>
      </StackPanel>
      <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" VerticalAlignment="Top"/>
    </Grid>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
      <Button Content="Characters" Command="{Binding ShowCharactersCommand}"/>
      <Button Content="Ships" Command="{Binding ShowShipsCommand}"/>
    </StackPanel>

    <Grid Grid.Row="2">
      <TextBlock Text="Loading roster..." IsVisible="{Binding IsLoading}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      <TextBlock Text="No cached roster units. Sync an account from Home to begin." IsVisible="{Binding IsEmpty}"
                 HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/>
      <StackPanel IsVisible="{Binding HasError}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="360">
        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="#FF8A80"/>
        <Button Content="Retry" Command="{Binding RefreshCommand}" HorizontalAlignment="Center"/>
      </StackPanel>
      <TextBlock Text="No units of this type are present in the cached roster." IsVisible="{Binding IsActiveBoardEmpty}"
                 HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/>

      <ScrollViewer IsVisible="{Binding HasCharacters}" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="10">
          <ItemsControl ItemsSource="{Binding RankedTiers}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="#1C222A" BorderBrush="#445160" BorderThickness="1" CornerRadius="7" Height="132">
                  <Grid ColumnDefinitions="112,*">
                    <Border Background="{Binding AccentColor}" CornerRadius="6,0,0,6" Padding="12">
                      <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding Title}" FontSize="34" FontWeight="Bold" Foreground="#10151B" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Count, StringFormat='{}{0} units'}" Foreground="#263238" HorizontalAlignment="Center"/>
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Padding="10" Height="130" Background="#151A20"
                            DragDrop.AllowDrop="True">
                      <ItemsControl ItemsSource="{Binding Characters}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel/>
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Classes="priority-card" Width="104" Margin="4" Padding="5" Background="#26344A"
                                    BorderBrush="#4C6B8A" BorderThickness="1" CornerRadius="6" Cursor="Hand"
                                    PointerPressed="CharacterCard_PointerPressed">
                              <StackPanel Spacing="5">
                                <Border Width="70" Height="70" CornerRadius="35" Background="#121A24" ClipToBounds="True" HorizontalAlignment="Center">
                                  <Grid>
                                    <TextBlock Text="{Binding Converter={StaticResource CharacterInitials}}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#9CC9FF"/>
                                    <Image Source="{Binding Converter={StaticResource CharacterPortrait}}" Stretch="UniformToFill"/>
                                  </Grid>
                                </Border>
                                <TextBlock Text="{Binding Converter={StaticResource CharacterDisplayName}}" FontSize="12" FontWeight="SemiBold"
                                           TextAlignment="Center" TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis"/>
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Border>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Background="#151A20" BorderBrush="#586773" BorderThickness="1" CornerRadius="7" MinHeight="132" Margin="0,8,0,0"
                  DataContext="{Binding UnrankedTier}" DragDrop.AllowDrop="True">
            <Grid ColumnDefinitions="112,*">
              <Border Background="{Binding AccentColor}" CornerRadius="6,0,0,6" Padding="12">
                <StackPanel VerticalAlignment="Center" Spacing="2">
                  <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" Foreground="#10151B" HorizontalAlignment="Center" TextAlignment="Center"/>
                  <TextBlock Text="{Binding Count, StringFormat='{}{0} units'}" Foreground="#263238" HorizontalAlignment="Center"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Padding="10" MinHeight="130" Background="#11161C">
                <ItemsControl ItemsSource="{Binding Characters}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Classes="priority-card" Width="104" Margin="4" Padding="5" Background="#26344A"
                              BorderBrush="#4C6B8A" BorderThickness="1" CornerRadius="6" Cursor="Hand"
                              PointerPressed="CharacterCard_PointerPressed">
                        <StackPanel Spacing="5">
                          <Border Width="70" Height="70" CornerRadius="35" Background="#121A24" ClipToBounds="True" HorizontalAlignment="Center">
                            <Grid>
                              <TextBlock Text="{Binding Converter={StaticResource CharacterInitials}}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#9CC9FF"/>
                              <Image Source="{Binding Converter={StaticResource CharacterPortrait}}" Stretch="UniformToFill"/>
                            </Grid>
                          </Border>
                          <TextBlock Text="{Binding Converter={StaticResource CharacterDisplayName}}" FontSize="12" FontWeight="SemiBold"
                                     TextAlignment="Center" TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </Grid>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <Canvas x:Name="DragPreviewLayer" Grid.RowSpan="3" IsHitTestVisible="False" Panel.ZIndex="100"/>
  </Grid>
</UserControl>
