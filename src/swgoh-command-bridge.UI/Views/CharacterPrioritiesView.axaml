<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:swgoh_command_bridge.UI.ViewModels"
             x:Class="swgoh_command_bridge.UI.Views.CharacterPrioritiesView"
             x:DataType="vm:CharacterPrioritiesViewModel">
  <Grid RowDefinitions="Auto, *" Margin="24">
    <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,16">
      <TextBlock Text="{Binding HeaderText}" FontSize="26" FontWeight="Bold"/>
      <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}"/>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="*, 280">
      <Grid>
        <TextBlock Text="Loading characters..." IsVisible="{Binding IsLoading}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <TextBlock Text="No cached characters. Sync an account from Home to begin." IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/>
        <StackPanel IsVisible="{Binding HasError}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="360">
          <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="#FF8A80"/>
          <Button Content="Retry" Command="{Binding RefreshCommand}" HorizontalAlignment="Center"/>
        </StackPanel>
        <ListBox ItemsSource="{Binding Characters}" SelectedItem="{Binding SelectedCharacter}" IsVisible="{Binding HasCharacters}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="*, Auto">
                <TextBlock Text="{Binding Name}"/>
                <TextBlock Grid.Column="1" Text="{Binding Priority, StringFormat='Priority: {0}' }"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <Border Grid.Column="1" BorderBrush="#555555" BorderThickness="1" CornerRadius="6" Padding="16" IsVisible="{Binding HasCharacters}">
        <StackPanel Spacing="12">
          <TextBlock Text="Selected character" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding SelectedCharacter.Name}" FontSize="16"/>
          <TextBlock Text="Priority (0–100)"/>
          <TextBox Text="{Binding SelectedCharacterPriority}"/>
          <TextBlock Text="{Binding ValidationError}" IsVisible="{Binding HasValidationError}" Foreground="#FF8A80" TextWrapping="Wrap"/>
          <TextBlock Text="Unsaved priority change" IsVisible="{Binding IsDirty}" Foreground="Gray"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Save priority" Command="{Binding SavePriorityCommand}" IsEnabled="{Binding CanSavePriority}"/>
            <Button Content="Cancel" Command="{Binding CancelEditCommand}" IsVisible="{Binding IsDirty}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
