<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:swgoh_command_bridge.UI.ViewModels"
             x:Class="swgoh_command_bridge.UI.Views.CharactersView"
             x:DataType="vm:CharactersViewModel">
  <Grid RowDefinitions="Auto, Auto, *" Margin="24">
    <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
      <TextBlock Text="{Binding HeaderText}" FontSize="26" FontWeight="Bold" VerticalAlignment="Center"/>
      <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}"/>
    </Grid>

    <TextBox Grid.Row="1" Margin="0,16,0,16" Text="{Binding SearchText}" Watermark="Search characters..."/>

    <Grid Grid.Row="2">
      <TextBlock Text="Loading characters..." IsVisible="{Binding IsLoading}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      <TextBlock Text="No cached characters. Sync an account from Home to begin." IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/>
      <StackPanel IsVisible="{Binding HasError}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="360">
        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="#FF8A80"/>
        <Button Content="Retry" Command="{Binding RefreshCommand}" HorizontalAlignment="Center"/>
      </StackPanel>

      <ListBox ItemsSource="{Binding Characters}" IsVisible="{Binding HasCharacters}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border BorderBrush="#444444" BorderThickness="0,0,0,1" Padding="8">
              <Grid ColumnDefinitions="*, Auto, Auto, Auto">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1" Text="{Binding Stars, StringFormat='Stars: {0}'}"/>
                <TextBlock Grid.Column="2" Text="{Binding GearLevel, StringFormat='Gear: {0}'}"/>
                <TextBlock Grid.Column="3" Text="{Binding Priority, StringFormat='Priority: {0}'}"/>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </Grid>
</UserControl>
