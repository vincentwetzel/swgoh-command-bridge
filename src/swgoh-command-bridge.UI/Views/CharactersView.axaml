<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:swgoh_command_bridge.UI.ViewModels"
             x:Class="swgoh_command_bridge.UI.Views.CharactersView"
             x:DataType="vm:CharactersViewModel">
  <Grid RowDefinitions="Auto, Auto, Auto, *" Margin="24">
    <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
      <TextBlock Text="{Binding HeaderText}" FontSize="26" FontWeight="Bold" VerticalAlignment="Center"/>
      <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}"/>
    </Grid>

    <TextBox Grid.Row="1" Margin="0,16,0,16" Text="{Binding SearchText}" Watermark="Search characters..."/>

    <TextBlock Grid.Row="2" Margin="0,0,0,8" Text="{Binding CatalogStatusText}" IsVisible="{Binding HasCatalogStatus}"
               Foreground="Gray" TextWrapping="Wrap"/>

    <Grid Grid.Row="3" ColumnDefinitions="*, 500">
      <Grid>
        <TextBlock Text="Loading characters..." IsVisible="{Binding IsLoading}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <TextBlock Text="No cached characters. Sync an account from Home to begin." IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/>
        <StackPanel IsVisible="{Binding HasError}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="360">
          <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="#FF8A80"/>
          <Button Content="Retry" Command="{Binding RefreshCommand}" HorizontalAlignment="Center"/>
        </StackPanel>

        <ListBox ItemsSource="{Binding Characters}" SelectedItem="{Binding SelectedCharacter}" IsVisible="{Binding HasCharacters}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="#444444" BorderThickness="0,0,0,1" Padding="8">
                <Grid ColumnDefinitions="64,*, Auto, Auto, Auto">
                  <Border Width="56" Height="56" CornerRadius="28" Background="#26344A" ClipToBounds="True">
                    <Grid>
                      <TextBlock Text="{Binding Converter={StaticResource CharacterInitials}}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#9CC9FF"/>
                      <Image Source="{Binding Converter={StaticResource CharacterPortrait}}" Stretch="UniformToFill"/>
                    </Grid>
                  </Border>
                  <TextBlock Grid.Column="1" Margin="14,0,0,0" Text="{Binding Converter={StaticResource CharacterDisplayName}}"
                             FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Column="2" Text="{Binding Stars, StringFormat='Stars: {0}'}" VerticalAlignment="Center" Foreground="Gray"/>
                  <TextBlock Grid.Column="3" Text="{Binding GearLevel, StringFormat='Gear: {0}'}" VerticalAlignment="Center" Foreground="Gray"/>
                  <TextBlock Grid.Column="4" Text="{Binding Priority, StringFormat='Priority: {0}'}" VerticalAlignment="Center"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <Border Grid.Column="1" Margin="16,0,0,0" BorderBrush="#3F4A55" BorderThickness="1" CornerRadius="8" Padding="16"
              IsVisible="{Binding HasCharacters}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="16">
            <ContentControl Content="{Binding SelectedCharacter}">
              <ContentControl.ContentTemplate>
                <DataTemplate>
                  <Border Background="#18222D" BorderBrush="#2D4B68" BorderThickness="1" CornerRadius="6" Padding="12">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                      <Border Width="64" Height="64" CornerRadius="32" Background="#26344A" ClipToBounds="True">
                        <Grid>
                          <TextBlock Text="{Binding Converter={StaticResource CharacterInitials}}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#9CC9FF"/>
                          <Image Source="{Binding Converter={StaticResource CharacterPortrait}}" Stretch="UniformToFill"/>
                        </Grid>
                      </Border>
                      <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding Converter={StaticResource CharacterDisplayName}}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Stars, StringFormat='Stars: {0}'}" Foreground="Gray"/>
                        <TextBlock Text="{Binding GearLevel, StringFormat='Gear: {0}'}" Foreground="Gray"/>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>
            <Border Background="#112C3C" BorderBrush="#2677A3" BorderThickness="1" CornerRadius="6" Padding="14">
              <StackPanel Spacing="10">
                <TextBlock Text="Recommended build" FontSize="19" FontWeight="SemiBold" Foreground="#A9DCFF"/>
                <TextBlock Text="{Binding PreferredModDataText}" Foreground="#B0BEC5" TextWrapping="Wrap"/>
                <StackPanel Spacing="4" IsVisible="{Binding HasPreferredSetups}">
                  <TextBlock Text="Common set combinations" FontWeight="SemiBold" Foreground="#D8EFFC"/>
                  <ItemsControl ItemsSource="{Binding PreferredSetups}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="#1A4056" CornerRadius="4" Padding="8,4" Margin="0,2">
                          <TextBlock Text="{Binding}" Foreground="#C7E9FF" TextWrapping="Wrap"/>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>
            </Border>

            <StackPanel Spacing="8" IsVisible="{Binding HasPreferredPrimaryAdvice}">
              <TextBlock Text="Recommended mod primaries" FontSize="19" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding PrimaryComparisonSummary}" Foreground="#A9DCFF" TextWrapping="Wrap"/>
              <Grid ColumnDefinitions="76,*,104,72" Margin="8,0,8,4">
                <TextBlock Text="SLOT" FontSize="11" Foreground="Gray" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1" Text="TARGET" FontSize="11" Foreground="Gray" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="2" Text="CURRENT" FontSize="11" Foreground="Gray" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="3" Text="RESULT" FontSize="11" Foreground="Gray" FontWeight="SemiBold"/>
              </Grid>
              <ItemsControl ItemsSource="{Binding PreferredPrimaryAdvice}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="#181C20" BorderBrush="{Binding ResultColor}" BorderThickness="3,0,0,0" CornerRadius="4" Padding="8" Margin="0,2">
                      <Grid ColumnDefinitions="76,*,104,72">
                        <TextBlock Text="{Binding Slot}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Target}" Foreground="#D9F0FF" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding Current}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="{Binding Result}" Foreground="{Binding ResultColor}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="8">
              <TextBlock Text="{Binding CurrentModsHeader}" FontSize="19" FontWeight="SemiBold"/>
              <TextBlock Text="No equipped mods are cached for this character." IsVisible="{Binding HasNoCurrentMods}" Foreground="Gray" TextWrapping="Wrap"/>
              <Grid ColumnDefinitions="78,74,70,*" Margin="8,0,8,2" IsVisible="{Binding HasCurrentMods}">
                <TextBlock Text="SHAPE" FontSize="11" Foreground="Gray" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1" Text="SET" FontSize="11" Foreground="Gray" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="2" Text="SPEED" FontSize="11" Foreground="Gray" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="3" Text="PRIMARY" FontSize="11" Foreground="Gray" FontWeight="SemiBold"/>
              </Grid>
              <ItemsControl ItemsSource="{Binding EquippedModDetails}" IsVisible="{Binding HasCurrentMods}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="#17191C" BorderBrush="#3B4148" BorderThickness="0,0,0,1" Padding="8">
                      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="78,74,70,*">
                        <TextBlock Text="{Binding Shape}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Set}" Foreground="#A9DCFF" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding SecondarySpeed}" Foreground="#68C98A" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="{Binding Primary}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Margin="0,5,8,0" Text="{Binding KeySecondaries, StringFormat='Secondaries: {0}'}" Foreground="#B0BEC5" FontSize="12" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" Margin="0,5,0,0" Text="{Binding Quality, StringFormat='Quality: {0}'}" Foreground="#B0BEC5" FontSize="12" TextWrapping="Wrap"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</UserControl>
