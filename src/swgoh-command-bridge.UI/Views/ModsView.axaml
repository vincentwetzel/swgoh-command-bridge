<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:swgoh_command_bridge.UI.ViewModels"
             xmlns:portrait="using:swgoh_command_bridge.UI.Views"
             xmlns:controls="using:swgoh_command_bridge.UI.Controls"
             x:Class="swgoh_command_bridge.UI.Views.ModsView"
             x:DataType="vm:ModsViewModel">
  <Grid RowDefinitions="Auto, *" Margin="20">
    <Grid Grid.Row="0" RowDefinitions="Auto, Auto, Auto" Margin="0,0,0,16">
      <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
        <TextBlock Text="{Binding HeaderText}" FontSize="26" FontWeight="Bold" VerticalAlignment="Center"/>
        <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}"/>
      </Grid>
      <Grid Grid.Row="1" RowDefinitions="Auto, Auto, Auto">
      <WrapPanel Grid.Row="0" Orientation="Horizontal" ItemHeight="32">
      <TextBox Width="180" Text="{Binding SearchText}" Watermark="Search mods..."/>
      <TextBox Width="190" Text="{Binding SecondaryFilter}" Watermark="Speed, OffensePercent&gt;=10"/>
      <ComboBox Width="150" ItemsSource="{Binding PrimaryStatOptions}" SelectedItem="{Binding PrimaryFilter}"/>
      <ComboBox Width="120" SelectedIndex="{Binding RarityFilter}">
        <ComboBoxItem>All pips</ComboBoxItem>
        <ComboBoxItem>1 pip</ComboBoxItem>
        <ComboBoxItem>2 pips</ComboBoxItem>
        <ComboBoxItem>3 pips</ComboBoxItem>
        <ComboBoxItem>4 pips</ComboBoxItem>
        <ComboBoxItem>5 pips</ComboBoxItem>
        <ComboBoxItem>6 pips</ComboBoxItem>
      </ComboBox>
      <ComboBox Width="120" SelectedIndex="{Binding SlotFilter}">
        <ComboBoxItem>All slots</ComboBoxItem>
        <ComboBoxItem>Square</ComboBoxItem>
        <ComboBoxItem>Arrow</ComboBoxItem>
        <ComboBoxItem>Diamond</ComboBoxItem>
        <ComboBoxItem>Triangle</ComboBoxItem>
        <ComboBoxItem>Circle</ComboBoxItem>
        <ComboBoxItem>Cross</ComboBoxItem>
      </ComboBox>
      <ComboBox Width="130" SelectedIndex="{Binding EquippedFilter}">
        <ComboBoxItem>All ownership</ComboBoxItem>
        <ComboBoxItem>Equipped</ComboBoxItem>
        <ComboBoxItem>Un-equipped</ComboBoxItem>
      </ComboBox>
      <ComboBox Width="120" SelectedIndex="{Binding SetFilter}">
        <ComboBoxItem>All sets</ComboBoxItem>
        <ComboBoxItem>Health</ComboBoxItem>
        <ComboBoxItem>Offense</ComboBoxItem>
        <ComboBoxItem>Defense</ComboBoxItem>
        <ComboBoxItem>Speed</ComboBoxItem>
        <ComboBoxItem>Crit Chance</ComboBoxItem>
        <ComboBoxItem>Crit Damage</ComboBoxItem>
        <ComboBoxItem>Potency</ComboBoxItem>
        <ComboBoxItem>Tenacity</ComboBoxItem>
      </ComboBox>
      <TextBox Width="100" Text="{Binding MinimumLevelFilter}" Watermark="Min level"/>
      <TextBox Width="90" Text="{Binding TierFilter}" Watermark="Tier"/>
      <ComboBox Width="110" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SortOption}"/>
      </WrapPanel>
      <TextBlock Grid.Row="1" Text="{Binding SecondaryFilterError}" IsVisible="{Binding HasSecondaryFilterError}" Foreground="#FF8A80"/>
      <Grid Grid.Row="2" ColumnDefinitions="*, Auto">
        <TextBlock Text="{Binding FilterSummaryText}" Foreground="Gray" VerticalAlignment="Center" TextWrapping="Wrap"/>
        <Button Grid.Column="1" Content="Clear filters" Command="{Binding ClearFiltersCommand}" IsVisible="{Binding HasActiveFilters}"/>
      </Grid>
      </Grid>
      <Grid Grid.Row="2" ColumnDefinitions="*, Auto, Auto, Auto" Margin="0,8,0,0">
        <TextBlock Text="{Binding ActiveThresholdText}" Foreground="Gray" VerticalAlignment="Center" TextWrapping="Wrap"/>
        <TextBlock Grid.Column="1" Text="{Binding PageText}" Foreground="Gray" VerticalAlignment="Center" Margin="12,0,0,0"/>
        <Button Grid.Column="2" Content="Previous" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanPreviousPage}"/>
        <Button Grid.Column="3" Content="Next" Command="{Binding NextPageCommand}" IsEnabled="{Binding CanNextPage}"/>
      </Grid>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="520"/>
        <ColumnDefinition Width="10"/>
        <ColumnDefinition Width="320" MinWidth="260"/>
      </Grid.ColumnDefinitions>
      <Grid Grid.Column="0">
        <TextBlock Text="Loading mods..." IsVisible="{Binding IsLoading}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <TextBlock Text="No cached mods. Sync an account from Home to begin." IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/>
        <StackPanel IsVisible="{Binding HasError}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="360">
          <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="#FF8A80"/>
          <Button Content="Retry" Command="{Binding RefreshCommand}" HorizontalAlignment="Center"/>
        </StackPanel>
        <TextBlock Text="No mods match the current filters." IsVisible="{Binding HasNoMatchingMods}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="Gray"/>

        <ListBox ItemsSource="{Binding FilteredMods}" SelectedItem="{Binding SelectedMod}" IsVisible="{Binding HasFilteredMods}">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="#444444" BorderThickness="0,0,0,1" Padding="10,10">
                <Grid ColumnDefinitions="76,170,230,*" RowDefinitions="Auto">
                  <controls:ModVisualControl Mod="{Binding}" Scale="1.05" Width="72" Height="64"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  <StackPanel Grid.Column="1" Margin="8,0,8,0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" MinWidth="0">
                    <portrait:CharacterPortraitView DataContext="{Binding OwnerCharacter}" Width="58" Height="52"
                                                    IsVisible="{Binding OwnerCharacter, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <TextBlock Text="{Binding OwnerDisplayName}" Width="84" Foreground="Gray"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                  </StackPanel>
                  <TextBlock Grid.Column="2" Margin="8,0" Text="{Binding PrimaryStatSummary}" FontWeight="SemiBold"
                             TextWrapping="Wrap" VerticalAlignment="Center"/>
                  <StackPanel Grid.Column="3" Spacing="3" MinWidth="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SecondaryStatsSummary}" Foreground="Gray" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" Background="#2D4B68"
                    Cursor="SizeWestEast" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                    ToolTip.Tip="Drag to resize the mod inventory and selected-mod panel" ToolTip.ShowDelay="0"/>

      <Border Grid.Column="2" BorderBrush="#555555" BorderThickness="1" CornerRadius="6" Padding="16">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="12">
          <TextBlock Text="Selected mod" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock Text="Select a cached mod to analyze." IsVisible="{Binding SelectedMod, Converter={x:Static ObjectConverters.IsNull}}" Foreground="Gray" TextWrapping="Wrap"/>
          <StackPanel IsVisible="{Binding SelectedMod, Converter={x:Static ObjectConverters.IsNotNull}}" Spacing="8">
            <controls:ModVisualControl Request="{Binding SelectedModVisualRequest}" Scale="1.15"
                                       HorizontalAlignment="Center" />
            <TextBlock Text="{Binding SelectedModSummaryText}" Foreground="Gray" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <portrait:CharacterPortraitView DataContext="{Binding SelectedMod.OwnerCharacter}" Width="58" Height="52"
                                              IsVisible="{Binding SelectedMod.OwnerCharacter, Converter={x:Static ObjectConverters.IsNotNull}}"/>
              <TextBlock Text="{Binding SelectedMod.OwnerDisplayName, StringFormat='Equipped owner: {0}'}"
                         TextWrapping="Wrap" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="{Binding SelectedMod.PrimaryStatType, StringFormat='Primary: {0}'}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding SelectedMod.PrimaryStatValue, StringFormat='Primary value: {0:F2}'}" TextWrapping="Wrap"/>
            <TextBlock Text="Secondary stats" FontWeight="SemiBold" IsVisible="{Binding HasSelectedSecondaryStats}"/>
            <ItemsControl ItemsSource="{Binding SelectedSecondarySummaries}" IsVisible="{Binding HasSelectedSecondaryStats}"/>
            <TextBlock Text="No readable secondary stats were cached." IsVisible="{Binding HasNoSelectedSecondaryStats}" Foreground="Gray"/>
            <TextBlock Text="{Binding SelectedModRecommendation.Action, StringFormat='Recommendation: {0}'}" FontWeight="Bold" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding SelectedModRecommendation.Score, StringFormat='Recommendation score: {0:F0}'}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding SelectedModRecommendation.RuleSummary}" Foreground="Gray" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding SelectedModRecommendation.EfficiencySummary}" Foreground="Gray" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding SelectedModRecommendation.Reason}" TextWrapping="Wrap" Foreground="Gray"/>
          </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</UserControl>
