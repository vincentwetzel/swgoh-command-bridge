<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:swgoh_command_bridge.UI.ViewModels"
             x:Class="swgoh_command_bridge.UI.Views.DiagnosticsView"
             x:DataType="vm:DiagnosticsViewModel">
  <ScrollViewer>
    <StackPanel Margin="24" Spacing="14" MaxWidth="820">
      <Grid ColumnDefinitions="*, Auto">
        <TextBlock Text="{Binding HeaderText}" FontSize="26" FontWeight="Bold"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Content="Refresh" Command="{Binding RefreshCommand}"/>
          <Button Content="Export diagnostics" Command="{Binding ExportCommand}"/>
        </StackPanel>
      </Grid>

      <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Foreground="Gray"/>
      <TextBlock Text="Loading diagnostics..." IsVisible="{Binding IsLoading}" Foreground="Gray"/>
      <Border IsVisible="{Binding HasError}" Background="#4A1F1F" BorderBrush="#FF8A80" BorderThickness="1" CornerRadius="4" Padding="10">
        <Grid ColumnDefinitions="*, Auto">
          <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="#FF8A80" VerticalAlignment="Center"/>
          <Button Grid.Column="1" Content="Retry" Command="{Binding RefreshCommand}"/>
        </Grid>
      </Border>
      <TextBlock Text="{Binding ExportStatusText}" TextWrapping="Wrap" Foreground="Gray"/>

      <Border BorderBrush="#555555" BorderThickness="1" CornerRadius="6" Padding="16">
        <StackPanel Spacing="8">
          <TextBlock Text="Environment" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding ComlinkEndpoint, StringFormat='Comlink endpoint: {0}'}" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding RedactedAllyCode, StringFormat='Default ally code: {0}'}"/>
          <TextBlock Text="{Binding SettingsPath, StringFormat='Settings path: {0}'}" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <Border BorderBrush="#555555" BorderThickness="1" CornerRadius="6" Padding="16">
        <StackPanel Spacing="8">
          <TextBlock Text="Recent sync attempts" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding RecentSyncHistoryText}"
                     TextWrapping="Wrap"
                     FontFamily="Consolas"
                     Foreground="Gray"/>
        </StackPanel>
      </Border>

      <Border BorderBrush="#555555" BorderThickness="1" CornerRadius="6" Padding="16">
        <StackPanel Spacing="8">
          <TextBlock Text="Local cache" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding CachePath, StringFormat='Cache path: {0}'}" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding BackupDirectory, StringFormat='Backup directory: {0}'}" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding PlayerCount, StringFormat='Players: {0}'}"/>
          <TextBlock Text="{Binding CharacterCount, StringFormat='Characters: {0}'}"/>
          <TextBlock Text="{Binding ModCount, StringFormat='Mods: {0}'}"/>
          <TextBlock Text="{Binding RecommendationCount, StringFormat='Recommendations: {0}'}"/>
          <TextBlock Text="{Binding LastAccountSyncText, StringFormat='Latest account sync: {0}'}"/>
          <TextBlock Text="{Binding LastSyncOutcomeText, StringFormat='Latest sync outcome: {0}'}" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding LastScrapeSummary, StringFormat='Last recommendation refresh: {0}'}" TextWrapping="Wrap" Foreground="Gray"/>
        </StackPanel>
      </Border>

      <Border BorderBrush="#555555" BorderThickness="1" CornerRadius="6" Padding="16">
        <StackPanel Spacing="8">
          <TextBlock Text="Recent application events" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding RecentEventsText}"
                     TextWrapping="Wrap"
                     FontFamily="Consolas"
                     Foreground="Gray"/>
        </StackPanel>
      </Border>

      <TextBlock Text="Exports exclude full ally codes, account payloads, and access keys. Review a report before sharing it." TextWrapping="Wrap" Foreground="Gray"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
