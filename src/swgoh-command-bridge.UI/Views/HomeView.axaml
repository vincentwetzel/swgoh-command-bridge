<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:swgoh_command_bridge.UI.ViewModels"
             x:Class="swgoh_command_bridge.UI.Views.HomeView"
             x:DataType="vm:MainWindowViewModel">
  <ScrollViewer>
    <StackPanel Margin="32" Spacing="18" MaxWidth="760">
      <TextBlock Text="{Binding Greeting}" FontSize="30" FontWeight="Bold"/>
      <TextBlock Text="Inspect characters, review mods, and build optimization plans using the account selected in the top-right account switcher."
                 TextWrapping="Wrap" Foreground="Gray"/>

      <Border BorderBrush="#555555" BorderThickness="1" CornerRadius="6" Padding="18">
        <StackPanel Spacing="10">
          <TextBlock Text="Active account" Foreground="Gray" FontSize="12"/>
          <TextBlock Text="{Binding ActiveAccountSummaryText}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding ActiveCacheFreshnessText}" TextWrapping="Wrap" Foreground="Gray"/>
          <TextBlock Text="{Binding ActiveSyncOutcomeText}" TextWrapping="Wrap" Foreground="Gray"/>
          <TextBlock Text="Refresh is recommended before relying on this cache for current recommendations."
                     IsVisible="{Binding IsActiveCacheStale}" TextWrapping="Wrap" Foreground="#FFCC80"/>
          <TextBlock Text="{Binding NextStepText}" TextWrapping="Wrap" Foreground="Gray"/>
          <Grid ColumnDefinitions="Auto, Auto, Auto" IsVisible="{Binding HasActiveCache}">
            <Button Grid.Column="0" Content="Inspect characters" Command="{Binding GoToCharactersCommand}" Padding="12,7"/>
            <Button Grid.Column="1" Content="Inspect mods" Command="{Binding GoToModsCommand}" Padding="12,7"/>
            <Button Grid.Column="2" Content="Open optimizer" Command="{Binding GoToOptimizerCommand}" Padding="12,7"/>
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
