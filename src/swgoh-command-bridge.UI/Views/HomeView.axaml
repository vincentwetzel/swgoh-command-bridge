<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:swgoh_command_bridge.UI.ViewModels"
             x:Class="swgoh_command_bridge.UI.Views.HomeView"
             x:DataType="vm:MainWindowViewModel">
  <ScrollViewer>
    <StackPanel Margin="32" Spacing="18" MaxWidth="760">
      <TextBlock Text="{Binding Greeting}" FontSize="30" FontWeight="Bold"/>
      <TextBlock Text="Sync a read-only roster cache, inspect your mods, and build optimization plans." TextWrapping="Wrap"/>

      <Border BorderBrush="#555555" BorderThickness="1" CornerRadius="6" Padding="18">
        <StackPanel Spacing="10">
          <TextBlock Text="Current cache" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding ActiveAccountSummaryText}" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding ActiveCacheFreshnessText}" TextWrapping="Wrap" Foreground="Gray"/>
          <TextBlock Text="{Binding ActiveSyncOutcomeText}" TextWrapping="Wrap" Foreground="Gray"/>
          <TextBlock Text="Refresh is recommended before relying on this cache for current recommendations."
                     IsVisible="{Binding IsActiveCacheStale}" TextWrapping="Wrap" Foreground="#FFCC80"/>
          <TextBlock Text="{Binding NextStepText}" TextWrapping="Wrap" Foreground="Gray"/>
          <Grid ColumnDefinitions="Auto, Auto, Auto, *" ColumnSpacing="8" IsVisible="{Binding HasActiveCache}">
            <Button Grid.Column="0" Content="Inspect characters" Command="{Binding GoToCharactersCommand}" Padding="12,7"/>
            <Button Grid.Column="1" Content="Inspect mods" Command="{Binding GoToModsCommand}" Padding="12,7"/>
            <Button Grid.Column="2" Content="Open optimizer" Command="{Binding GoToOptimizerCommand}" Padding="12,7"/>
          </Grid>
        </StackPanel>
      </Border>

      <Border BorderBrush="#555555" BorderThickness="1" CornerRadius="6" Padding="18">
        <StackPanel Spacing="12">
          <TextBlock Text="Account sync" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock Text="Comlink ally code"/>
          <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
            <TextBox Grid.Column="0" Text="{Binding AllyCode}" Watermark="123456789"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <Button Content="Sync account" Command="{Binding SyncCommand}" Padding="18,8"/>
              <Button Content="Cancel" Command="{Binding CancelSyncCommand}" IsVisible="{Binding CanCancelSync}" Padding="12,8"/>
              <Button Content="Retry" Command="{Binding RetrySyncCommand}" IsVisible="{Binding CanRetrySync}" Padding="12,8"/>
            </StackPanel>
          </Grid>
          <TextBlock Text="{Binding AllyCodeValidationMessage}" IsVisible="{Binding HasAllyCodeValidationError}" Foreground="#FF8A80"/>
          <TextBlock Text="Cached accounts" IsVisible="{Binding HasCachedAccounts}"/>
          <TextBox Text="{Binding AccountSearchText}"
                   Watermark="Filter cached accounts by name or ally code"
                   IsVisible="{Binding HasCachedAccounts}"/>
          <TextBlock Text="{Binding CachedAccountFilterStatusText}"
                     IsVisible="{Binding HasCachedAccounts}"
                     Foreground="Gray"/>
          <TextBlock Text="No cached accounts match this filter."
                     IsVisible="{Binding HasNoVisibleCachedAccounts}"
                     Foreground="#FFCC80"/>
          <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10" IsVisible="{Binding HasVisibleCachedAccounts}">
            <ComboBox Grid.Column="0"
                      ItemsSource="{Binding VisibleCachedAccounts}"
                      SelectedItem="{Binding SelectedCachedAccount}"
                      MaxWidth="420">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Name}"/>
                    <TextBlock Text="{Binding AllyCode}" Foreground="Gray"/>
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="1" Content="Use cached account" Command="{Binding UseCachedAccountCommand}"/>
          </Grid>
          <CheckBox Content="I understand this removes the cached roster and mod data for the selected account."
                    IsChecked="{Binding ConfirmAccountRemoval}"
                    IsVisible="{Binding HasCachedAccounts}"
                    TextWrapping="Wrap"/>
          <Button Content="Remove selected cached account"
                  Command="{Binding RemoveCachedAccountCommand}"
                  IsVisible="{Binding HasCachedAccounts}"
                  HorizontalAlignment="Left"
                  Padding="12,8"/>
          <TextBlock Text="{Binding AccountManagementStatusText}"
                     TextWrapping="Wrap"
                     Foreground="#FFCC80"/>
          <TextBlock Text="{Binding SyncStatusText}" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding SyncSummaryText}" IsVisible="{Binding HasSyncSummary}" TextWrapping="Wrap" Foreground="Gray"/>
          <TextBlock Text="{Binding SyncProgressText}" IsVisible="{Binding HasSyncProgress}" TextWrapping="Wrap" Foreground="Gray"/>
          <TextBlock Text="{Binding SyncDiagnosticsText}" IsVisible="{Binding HasSyncDiagnostics}" TextWrapping="Wrap" Foreground="#FFCC80"/>
        </StackPanel>
      </Border>

      <TextBlock Text="Use the navigation above after a successful sync. Cached data remains available when Comlink is offline." TextWrapping="Wrap" Foreground="Gray"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
