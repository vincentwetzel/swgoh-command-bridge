<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:swgoh_command_bridge.UI.ViewModels"
             x:Class="swgoh_command_bridge.UI.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <Grid RowDefinitions="Auto, *" Margin="24">
    <TextBlock Grid.Row="0" Text="{Binding HeaderText}" FontSize="26" FontWeight="Bold" Margin="0,0,0,18"/>
    <Border Grid.Row="1" BorderBrush="#555555" BorderThickness="1" CornerRadius="6" Padding="18" MaxWidth="620" HorizontalAlignment="Left">
      <StackPanel Spacing="12">
        <TextBlock Text="Comlink base URL"/>
        <TextBox Text="{Binding ComlinkBaseUrl}" Watermark="http://localhost:3000"/>
        <TextBlock Text="Default ally code"/>
        <TextBox Text="{Binding DefaultAllyCode}" Watermark="123456789"/>
        <TextBlock Text="Theme"/>
        <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Theme}"/>
        <CheckBox Content="Allow local swgoh.gg recommendation scraping" IsChecked="{Binding EnableLocalRecommendationScraping}"/>
        <TextBlock Text="When disabled, cached recommendations remain available but the app will not make new local scraping requests. A future central recommendation service can replace this path." TextWrapping="Wrap" Foreground="Gray"/>
        <TextBlock Text="Recommendation contact email (optional)"/>
        <TextBox Text="{Binding RecommendationContactEmail}" Watermark="you@example.com"/>
        <TextBlock Text="If supplied, this is sent as the HTTP From header so swgoh.gg operators can identify the client. It is included in settings transfers." TextWrapping="Wrap" Foreground="Gray"/>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Content="Test connection" Command="{Binding TestConnectionCommand}"/>
          <Button Content="Save settings" Command="{Binding SaveCommand}"/>
        </StackPanel>
        <TextBlock Text="Working..." IsVisible="{Binding IsLoading}" Foreground="Gray"/>
        <Border IsVisible="{Binding HasError}" Background="#4A1F1F" BorderBrush="#FF8A80" BorderThickness="1" CornerRadius="4" Padding="8">
          <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="#FF8A80"/>
        </Border>
        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Foreground="Gray"/>
        <Separator/>
        <TextBlock Text="Portable settings" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Text="Export or import the application settings as a versioned JSON document. Embedded URL credentials are excluded." TextWrapping="Wrap" Foreground="Gray"/>
        <TextBox Text="{Binding SettingsTransferPath}" Watermark="C:\path\settings.json"/>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Content="Export settings" Command="{Binding ExportSettingsCommand}"/>
          <Button Content="Import settings" Command="{Binding ImportSettingsCommand}"/>
        </StackPanel>
        <TextBlock Text="{Binding SettingsTransferStatusText}" TextWrapping="Wrap" Foreground="Gray"/>
        <Separator/>
        <TextBlock Text="Character catalog update" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Text="Download the current swgoh-characters.json and swgoh-ships.json files in your browser, enter their paths below, then import. The app validates the complete ID/name/image catalog before activating it and refreshes cached roster names immediately." TextWrapping="Wrap" Foreground="Gray"/>
        <TextBox Text="{Binding CharacterCatalogPath}" Watermark="Full path to swgoh-characters.json"/>
        <TextBox Text="{Binding ShipCatalogPath}" Watermark="Full path to swgoh-ships.json"/>
        <Button Content="Import catalog snapshots" Command="{Binding ImportCatalogCommand}"/>
        <TextBlock Text="{Binding CatalogUpdateStatusText}" TextWrapping="Wrap" Foreground="Gray"/>
        <TextBlock Text="New portrait images must also exist in the installed portrait asset pack; otherwise the character still receives its canonical name and uses the initials fallback." TextWrapping="Wrap" Foreground="Gray"/>
        <Separator/>
        <TextBlock Text="Cache backup" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Text="Create a portable SQLite backup before resetting or troubleshooting the cache." TextWrapping="Wrap" Foreground="Gray"/>
        <Button Content="Back up local cache" Command="{Binding BackupCacheCommand}"/>
        <TextBlock Text="{Binding BackupStatusText}" TextWrapping="Wrap" Foreground="Gray"/>
        <Separator/>
        <TextBlock Text="Restore cache" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Text="Restore only a backup created under the cache backups directory. The file is integrity-checked before replacement." TextWrapping="Wrap" Foreground="Gray"/>
        <TextBox Text="{Binding RestoreBackupPath}" Watermark="Full path to cache-...db"/>
        <CheckBox Content="I understand this replaces the local cache" IsChecked="{Binding ConfirmCacheRestore}"/>
        <Button Content="Restore selected backup" Command="{Binding RestoreCacheCommand}"/>
        <TextBlock Text="{Binding RestoreStatusText}" TextWrapping="Wrap" Foreground="Gray"/>
        <Separator/>
        <TextBlock Text="Cache recovery" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Text="Resetting removes cached players, characters, mods, and recommendations. Your Settings values are preserved." TextWrapping="Wrap" Foreground="Gray"/>
        <CheckBox Content="I understand this removes the local cache" IsChecked="{Binding ConfirmCacheReset}"/>
        <Button Content="Reset local cache" Command="{Binding ResetCacheCommand}"/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
